{
  "name": "cortico-bot-weighted-memory",
  "version": "0.2.6",
  "type": "module",
  "main": "./index.ts",
  "description": "权重检索：让 Cortico 按重要程度记住有用的事，查回原话，分清谁说的，并保留审核与纠错记录。",
  "license": "MIT",
  "keywords": [
    "cortico-bot",
    "cortico",
    "memory",
    "persona",
    "weighted-memory"
  ],
  "engines": {
    "node": ">=22.16.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kpect10086/Cortico-Weighted-Memory.git"
  },
  "homepage": "https://github.com/Kpect10086/Cortico-Weighted-Memory#readme",
  "bugs": {
    "url": "https://github.com/Kpect10086/Cortico-Weighted-Memory/issues"
  },
  "cortico": {
    "kind": "bot",
    "api": 7,
    "displayName": "权重检索",
    "webUiClient": "./dist/webui.js",
    "webUiStyle": "./dist/webui.css",
    "describe": "describe.json",
    "tags": [
      "memory",
      "experimental",
      "sensitive-data"
    ],
    "locales": {
      "zh": {
        "displayName": "权重检索"
      },
      "en": {
        "displayName": "Weighted Retrieval"
      }
    }
  },
  "files": [
    "*.ts",
    "*.mjs",
    "*.mts",
    "base",
    "migrations",
    "dist/webui.js",
    "describe.json",
    "README.md",
    "HOSTING.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "tests",
    "scripts",
    "tsconfig*.json",
    "dist/webui.css",
    "docs"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "test": "node self-check.mjs && tsx context-self-check.ts && tsx hosting-self-check.ts && node --import tsx --test tests/install.test.ts tests/export.test.ts tests/workspace.test.ts tests/import.test.ts tests/migrate.test.ts tests/retrieval.test.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json --noEmit",
    "build:web": "node scripts/build-web.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cortico": "0.2.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "esbuild": "^0.28.2"
  }
}
